<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">
  <defs>
    <linearGradient id="cinematicGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#161616" />
      <stop offset="50%" stop-color="#101010" />
      <stop offset="100%" stop-color="#090909" />
    </linearGradient>
    <radialGradient id="lensGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#D55C03" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#090909" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#cinematicGrad)" />
  <circle cx="600" cy="400" r="350" fill="url(#lensGlow)" />
  <rect x="50" y="50" width="1100" height="700" fill="none" stroke="#F4F4F1" stroke-width="1" stroke-opacity="0.08" />
  
  <!-- Frame marks -->
  <line x1="80" y1="80" x2="120" y2="80" stroke="#D55C03" stroke-width="2" />
  <line x1="80" y1="80" x2="80" y2="120" stroke="#D55C03" stroke-width="2" />
  
  <line x1="1120" y1="80" x2="1080" y2="80" stroke="#D55C03" stroke-width="2" />
  <line x1="1120" y1="80" x2="1120" y2="120" stroke="#D55C03" stroke-width="2" />

  <line x1="80" y1="720" x2="120" y2="720" stroke="#D55C03" stroke-width="2" />
  <line x1="80" y1="720" x2="80" y2="680" stroke="#D55C03" stroke-width="2" />

  <line x1="1120" y1="720" x2="1080" y2="720" stroke="#D55C03" stroke-width="2" />
  <line x1="1120" y1="720" x2="1120" y2="680" stroke="#D55C03" stroke-width="2" />

  <text x="600" y="380" fill="#F4F4F1" font-family="sans-serif" font-size="28" font-weight="700" letter-spacing="4" text-anchor="middle">SAMIR EL-HOSARY</text>
  <text x="600" y="420" fill="#8F8F8F" font-family="sans-serif" font-size="14" letter-spacing="3" text-anchor="middle">DIRECTOR &amp; FILMMAKER • 2.39:1 CINEMATIC FRAME</text>
  <circle cx="600" cy="455" r="4" fill="#D55C03" />
</svg>
